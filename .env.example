# Hanya kredensial Gemini yang tertanam. Login UT dilakukan manual di browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini (opsional). Kosongkan untuk default 'gemini-flash-lite-latest'
# (flash-lite: kuota gratis paling longgar, cukup untuk menilai forum).
# Alternatif: gemini-3.5-flash-lite, gemini-flash-latest, gemini-2.5-pro, dll.
GEMINI_MODEL=

# Konteks penilaian AI (opsional; bisa juga dibiarkan kosong dan diambil dari judul thread).
FORUM_QUESTION=

# true = kirim balasan otomatis; false = berhenti untuk direview dulu.
AUTO_SUBMIT=false
